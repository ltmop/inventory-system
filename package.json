{
  "name": "inventory-system",
  "private": true,
  "version": "0.4.1",
  "homepage": "https://junchengzn.com",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "electron": "electron .",
    "dev-electron": "node scripts/dev-electron.cjs",
    "dist": "node scripts/dist.cjs"
  },
  "description": "通用进销存系统（超市/便利店/五金/文具/日杂）本地进销存桌面软件，支持云同步多设备",
  "author": "阿杜",
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@sentry/electron": "^7.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.474.0",
    "motion": "^12.42.2",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2",
    "recharts": "^2.15.1",
    "sherpa-onnx-node": "^1.13.4",
    "tailwind-merge": "^3.0.1",
    "tw-animate-css": "^1.0.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.3",
    "@types/node": "^22.13.1",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.0.3",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "build": {
    "appId": "com.inventory.system",
    "productName": "AI智能进销存系统",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-win-x64/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "generic",
      "url": "https://sync.junchengzn.com/updates/"
    }
  }
}